{
  "name": "lycoris",
  "version": "1.0.0",
  "description": "Chrome Extension: Queue multiple image prompts in ChatGPT, generate sequentially, process locally, download as ZIP",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
